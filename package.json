{
  "name": "youscrapper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MP3/MP4 downloader for YouTube, TikTok and Instagram (React + yt-dlp)",
  "scripts": {
    "postinstall": "node scripts/ytdlp.js",
    "start": "vite build && electron .",
    "dev": "concurrently -k -n server,web -c cyan,magenta \"node --watch server/index.js\" \"vite\"",
    "dist": "vite build && electron-builder --win",
    "update-ytdlp": "node scripts/ytdlp.js --force",
    "release": "npm run dist && node scripts/release.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.0.0"
  },
  "main": "electron/main.js",
  "author": "YouScrapper",
  "build": {
    "appId": "com.youscrapper.app",
    "productName": "YouScrapper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "server/**",
      "scripts/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": [
        "msi",
        "portable"
      ]
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "YouScrapper-Setup-${version}.msi"
    },
    "portable": {
      "artifactName": "YouScrapper-Portable-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
